{
  "name": "session-projection-verifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "递归会话规程投影复核器：校验全局规程并为每个参与方投影规范本地状态机",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc --noEmit -p web/tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test tests/engine.test.ts",
    "smoke": "node verify/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.3"
  }
}
